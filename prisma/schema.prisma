// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @map("nama") // e.g., "SUPER_ADMIN", "ADMIN_DLH", "CAMAT", "LURAH", "RW", "PETUGAS_RESIDU", "WARGA", "MAHASISWA_KKN"
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  users     User[]

  @@map("peran")
}

model User {
  id              String            @id @default(uuid())
  name            String            @map("nama")
  email           String?           @unique @map("surel")
  password        String            @map("kata_sandi")
  nik             String?           @unique
  status          String            @default("Aktif")
  fcmToken        String?           @map("token_fcm")
  roleId          Int               @map("id_peran")
  role            Role              @relation(fields: [roleId], references: [id])
  rtRwId          Int?              @map("id_rt_rw")
  rtRw            RtRwArea?         @relation(fields: [rtRwId], references: [id])
  fotoProfil      String?           @map("foto_profil")
  phone           String            @unique @map("phone")
  address         String?           @map("address")
  wargaSubtype    String?           @map("warga_subtype") // "UTAMA", "TAMBAHAN"
  createdAt       DateTime          @default(now()) @map("dibuat_pada")
  updatedAt       DateTime          @updatedAt @map("diperbarui_pada")
  households      Household[]
  aiRequestLogs   AiRequestLog[]
  pointHistory    PointHistory[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  requestedResets BinResetRequest[] @relation("RequestedResets")
  reviewedResets  BinResetRequest[] @relation("ReviewedResets")
  bins            Bin[]             @relation("UserBins")
  binOwnerships   BinOwnership[]
  picBatches      QrBatch[]         @relation("PicBatches")
  studentProfile  StudentKkn?
  petugasProfile  PetugasResidu?
  bankSampahLedger BankSampahLedger?
  ideDaurUlang    IdeDaurUlang[]
  auditLogs       AuditTrail[]
  claimedTasks    DispatchTask[]    @relation("ClaimedTasks")
  verifiedLogs    WasteLog[]        @relation("VerifiedLogs")
  wargaViolations   Violation[]       @relation("WargaViolations")
  recordedViolations Violation[]      @relation("RecordedViolations")
  fromHandovers KknHandoverHistory[] @relation("FromStudentHandovers")
  toHandovers   KknHandoverHistory[] @relation("ToStudentHandovers")
  residuLogs        ResiduLog[]

  @@map("pengguna")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")

  @@map("token_penyegar")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  used      Boolean  @default(false)

  @@map("kode_otp")
}

model Kelurahan {
  id        String     @id @default(uuid())
  name      String     @unique @map("nama") // e.g., "Dago", "Sadangserang"
  createdAt DateTime   @default(now()) @map("dibuat_pada")
  updatedAt DateTime   @updatedAt @map("diperbarui_pada")
  rtRwAreas RtRwArea[]
  bins      Bin[]      // Needed for Bulk Generate

  @@map("kelurahan")
}

model RtRwArea {
  id          Int          @id @default(autoincrement())
  kelurahanId String       @map("id_kelurahan")
  kelurahan   Kelurahan    @relation(fields: [kelurahanId], references: [id])
  name        String       @map("nama") // e.g., "RT 01 / RW 05"
  createdAt   DateTime     @default(now()) @map("dibuat_pada")
  updatedAt   DateTime     @updatedAt @map("diperbarui_pada")
  households  Household[]
  bins        Bin[]
  users       User[]
  studentsKkn StudentKkn[]
  handovers   KknHandoverHistory[]
  facilities  Facility[]
  residuLogs  ResiduLog[]

  @@unique([kelurahanId, name])
  @@map("wilayah_rt_rw")
}

model Household {
  id        String     @id @default(uuid())
  userId    String     @map("id_pengguna")
  user      User       @relation(fields: [userId], references: [id])
  address   String
  rtRwId    Int        @map("id_rt_rw")
  rtRw      RtRwArea   @relation(fields: [rtRwId], references: [id])
  latitude  Decimal    @db.Decimal(11, 8)
  longitude Decimal    @db.Decimal(11, 8)
  createdAt DateTime   @default(now()) @map("dibuat_pada")
  updatedAt DateTime   @updatedAt @map("diperbarui_pada")
  wasteLogs WasteLog[]

  @@map("rumah_tangga")
}

model WasteCategory {
  id          String     @id @default(uuid())
  name        String     @unique @map("nama") // e.g., "ORGANIC", "NON_ORGANIC", "B3"
  pointsPerKg Int        @map("poin_per_kg")
  description String?
  createdAt   DateTime   @default(now()) @map("dibuat_pada")
  updatedAt   DateTime   @updatedAt @map("diperbarui_pada")
  bins        Bin[]
  wasteLogs   WasteLog[]

  @@map("kategori_sampah")
}

enum BinStatus {
  PRINTED
  ASSIGNED_TO_PIC
  PENDING_APPROVAL
  ACTIVE_BOUND
  BROKEN
  INACTIVE
}


model QrBatch {
  id                String    @id @default(uuid())
  batchCode         String    @unique @map("kode_gelombang")
  status            String    // e.g. "PRINTED", "ASSIGNED_TO_PIC", "ACTIVE_BOUND"
  assignedPicUserId String?   @map("id_pengguna_pic_ditugaskan")
  assignedPic       User?     @relation("PicBatches", fields: [assignedPicUserId], references: [id])
  totalQr           Int       @map("total_qr")
  printedAt         DateTime  @default(now()) @map("dicetak_pada")
  createdAt         DateTime  @default(now()) @map("dibuat_pada")
  updatedAt         DateTime  @updatedAt @map("diperbarui_pada")
  bins              Bin[]

  @@map("gelombang_qr")
}

model Bin {
  id                          String            @id @default(uuid())
  qrCode                      String            @unique @map("kode_qr")
  categoryId                  String            @map("id_kategori")
  category                    WasteCategory     @relation(fields: [categoryId], references: [id])
  maxCapacityLiter            Decimal           @default(25.0) @map("maks_kapasitas_liter") @db.Decimal(5, 2)
  currentVolumeLiter          Decimal           @default(0.0) @map("volume_sekarang_liter") @db.Decimal(5, 2)
  height                      Decimal?          @db.Decimal(5, 2) @map("tinggi")
  width                       Decimal?          @db.Decimal(5, 2) @map("lebar")
  length                      Decimal?          @db.Decimal(5, 2) @map("panjang")
  diameter                    Decimal?          @db.Decimal(5, 2) @map("diameter")
  shape                       String?           @map("bentuk") // RECTANGLE, CYLINDER
  binType                     String?           @map("tipe_wadah") // STANDARD, CUSTOM
  rtRwId                      Int               @map("id_rt_rw")
  rtRw                        RtRwArea          @relation(fields: [rtRwId], references: [id])
  kelurahanId                 String?           @map("id_kelurahan")
  kelurahan                   Kelurahan?        @relation(fields: [kelurahanId], references: [id])
  latitude                    Decimal?          @db.Decimal(11, 8)
  longitude                   Decimal?          @db.Decimal(11, 8)
  status                      BinStatus         @default(PRINTED)
  binOwnerships               BinOwnership[]
  qrBatchId                   String?           @map("id_gelombang_qr")
  qrBatch                     QrBatch?          @relation(fields: [qrBatchId], references: [id], onDelete: SetNull)
  createdAt                   DateTime          @default(now()) @map("dibuat_pada")
  updatedAt                   DateTime          @updatedAt @map("diperbarui_pada")
  userId                      String?           @map("id_pengguna")
  user                        User?             @relation("UserBins", fields: [userId], references: [id], onDelete: SetNull)
  wasteLogs                   WasteLog[]
  binResetRequests            BinResetRequest[]
  dispatchTasks               DispatchTask[]
  violations                  Violation[]

  @@map("tong_sampah")
}

model WasteLog {
  id                   String        @id @default(uuid())
  householdId          String        @map("id_rumah_tangga")
  household            Household     @relation(fields: [householdId], references: [id])
  binId                String        @map("id_tong")
  bin                  Bin           @relation(fields: [binId], references: [id])
  weightKg             Decimal       @map("berat_kg") @db.Decimal(5, 2)
  volumeLiter          Decimal       @map("volume_liter") @db.Decimal(5, 2)
  categoryId           String        @map("id_kategori")
  category             WasteCategory @relation(fields: [categoryId], references: [id])
  requestId            String        @map("id_permintaan") @db.Uuid
  aiConfidence         Decimal?      @map("kepercayaan_ai") @db.Decimal(5, 2)
  aiClassification     String?       @map("klasifikasi_ai")
  actualWeightPetugas  Decimal?      @map("berat_aktual_petugas") @db.Decimal(5, 2)
  discrepancyStatus    String        @default("NONE") @map("status_diskrepansi") // NONE, PENDING_REVIEW, RESOLVED
  geolocation          String?       @map("geolocation")
  verifiedByPetugasId  String?       @map("id_petugas_verifikator")
  verifiedByPetugas    User?         @relation("VerifiedLogs", fields: [verifiedByPetugasId], references: [id], onDelete: SetNull)
  verifiedAt           DateTime?     @map("diverifikasi_pada")
  petugasClassification String?      @map("klasifikasi_petugas")
  evidencePhotoUrl     String?       @map("url_foto_bukti_petugas")
  createdAt            DateTime      @default(now()) @map("dibuat_pada")
  updatedAt            DateTime      @updatedAt @map("diperbarui_pada")

  @@map("catatan_setoran")
}

model ResiduLog {
  id               String   @id @default(uuid())
  rtRwId           Int      @map("id_rt_rw")
  rtRw             RtRwArea @relation(fields: [rtRwId], references: [id])
  petugasId        String   @map("id_pengguna_petugas")
  petugas          User     @relation(fields: [petugasId], references: [id])
  beratKg          Decimal  @map("berat_kg") @db.Decimal(10, 2)
  fotoUrl          String?  @map("url_foto")
  waktu            DateTime @default(now()) @map("waktu")
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  updatedAt        DateTime @updatedAt @map("diperbarui_pada")

  @@map("catatan_residu")
}

model StudentKkn {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("id_pengguna")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nim                String    @unique
  jurusan            String
  fakultas           String
  noWa               String    @map("no_wa")
  startDate          DateTime  @map("tanggal_mulai")
  endDate            DateTime  @map("tanggal_selesai")
  assignedPolygonId  Int?      @map("id_poligon_ditugaskan")
  assignedPolygon    RtRwArea? @relation(fields: [assignedPolygonId], references: [id])
  whitelistStatus    String    @default("PENDING") @map("status_whitelist") // PENDING, APPROVED, REJECTED
  createdAt          DateTime  @default(now()) @map("dibuat_pada")
  updatedAt          DateTime  @updatedAt @map("diperbarui_pada")

  @@map("mahasiswa_kkn")
}

model PetugasResidu {
  id           String   @id @default(uuid())
  userId       String   @unique @map("id_pengguna")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama         String
  noWa         String   @map("no_wa")
  kpiScore     Decimal  @default(100.0) @map("skor_kpi") @db.Decimal(5, 2)
  assignedZone String?  @map("zona_ditugaskan")
  latitude     Decimal? @db.Decimal(11, 8) @map("latitude")
  longitude    Decimal? @db.Decimal(11, 8) @map("longitude")
  whitelistStatus String @default("PENDING") @map("status_whitelist") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now()) @map("dibuat_pada")
  updatedAt    DateTime @updatedAt @map("diperbarui_pada")

  @@map("petugas_residu")
}

enum FacilityType {
  loseda
  bata_terawang
  rumah_maggot
  bank_sampah
  tps
}

model Facility {
  id             String                  @id @default(uuid())
  jenis          FacilityType
  nama           String
  pic            String
  foto           String?
  kontak         String?
  kapasitas      Decimal?                @db.Decimal(10, 2)
  latitude       Decimal                 @db.Decimal(11, 8)
  longitude      Decimal                 @db.Decimal(11, 8)
  rtRwId         Int?                    @map("id_rt_rw")
  rtRw           RtRwArea?               @relation(fields: [rtRwId], references: [id])
  statusApproval String                  @default("PENDING") @map("status_persetujuan") // PENDING, APPROVED, REJECTED
  createdAt      DateTime                @default(now()) @map("dibuat_pada")
  updatedAt      DateTime                @updatedAt @map("diperbarui_pada")
  productionLogs FacilityProductionLog[]

  @@map("fasilitas")
}

model FacilityProductionLog {
  id              String   @id @default(uuid())
  facilityId      String   @map("id_fasilitas")
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  materialMasukKg Decimal  @map("material_masuk_kg") @db.Decimal(10, 2)
  outputKg        Decimal  @map("output_kg") @db.Decimal(10, 2)
  jenisOutput     String   @map("jenis_output") // e.g. "Pre-Pupa", "Pupa", "Maggot Kering"
  periode         String   // e.g. "2026-W29"
  createdAt       DateTime @default(now()) @map("dibuat_pada")

  @@map("catatan_produksi_fasilitas")
}

model BankSampahLedger {
  id               String   @id @default(uuid())
  userId           String   @unique @map("id_pengguna")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saldoRupiah      Decimal  @default(0.0) @map("saldo_rupiah") @db.Decimal(12, 2)
  riwayatTransaksi Json     @default("[]") @map("riwayat_transaksi")
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  updatedAt        DateTime @updatedAt @map("diperbarui_pada")

  @@map("buku_kas_bank_sampah")
}

model IdeDaurUlang {
  id             String   @id @default(uuid())
  userId         String   @map("id_pengguna")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  judul          String
  foto           String?
  material       String
  statusApproval String   @default("PENDING") @map("status_persetujuan") // PENDING, APPROVED, REJECTED
  approvedBy     String?  @map("disetujui_oleh")
  createdAt      DateTime @default(now()) @map("dibuat_pada")
  updatedAt      DateTime @updatedAt @map("diperbarui_pada")

  @@map("ide_daur_ulang")
}

model FlashDropEvent {
  id        String   @id @default(uuid())
  title     String
  latitude  Decimal  @db.Decimal(11, 8)
  longitude Decimal  @db.Decimal(11, 8)
  radius    Int      @default(100) // meter
  points    Int      @default(50)
  startTime DateTime @map("waktu_mulai")
  endTime   DateTime @map("waktu_selesai")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  @@map("aksi_drop_sampah")
}

model SystemConfig {
  key       String   @id
  value     String
  tipe      String   // string, number, boolean
  deskripsi String?
  updatedBy String?  @map("diperbarui_oleh")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  @@map("konfigurasi_sistem")
}

model AuditTrail {
  id        String   @id @default(uuid())
  action    String
  userId    String?  @map("id_pengguna")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp DateTime @default(now())
  oldValue  Json?    @map("nilai_lama")
  newValue  Json?    @map("nilai_baru")

  @@map("jejak_audit")
}

model SocialFeed {
  id        String   @id @default(uuid())
  tipe      String   // e.g. "MAGGOT_HARVEST", "BADGE_UNLOCKED", "RECYCLE_IDEA"
  deskripsi String
  userId    String?  @map("id_pengguna")
  entityId  String?  @map("id_entitas")
  timestamp DateTime @default(now())

  @@map("kabar_sosial")
}

model NotificationLog {
  id          String   @id @default(uuid())
  channel     String   // WA, EMAIL, FCM
  tujuan      String   // phone number, email address, or FCM token
  statusKirim String   @map("status_kirim") // SUCCESS, FAILED
  triggerType String   @map("tipe_pemicu") // e.g. OTP, PUSH_ALARM, DAILY_REPORT
  createdAt   DateTime @default(now()) @map("dibuat_pada")

  @@map("catatan_notifikasi")
}

model AiRequestLog {
  id           String   @id @default(uuid())
  userId       String   @map("id_pengguna")
  user         User     @relation(fields: [userId], references: [id])
  requestId    String   @unique @map("id_permintaan") @db.Uuid
  imageUrl     String   @map("url_gambar")
  resultStatus String   @map("status_hasil") // e.g., "SUCCESS", "TIMEOUT", "IMAGE_UNREADABLE"
  createdAt    DateTime @default(now()) @map("dibuat_pada")

  @@map("catatan_permintaan_ai")
}

model PointHistory {
  id          String   @id @default(uuid())
  userId      String   @map("id_pengguna")
  user         User     @relation(fields: [userId], references: [id])
  points      Int
  description String
  kategori    String   @default("REDUKSI_TONASE") @map("kategori") // REDUKSI_TONASE, PARTISIPASI_STREAK, IDE_DAUR_ULANG
  redeemable  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("dibuat_pada")

  @@map("riwayat_poin")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false) @map("sudah_dibaca")
  createdAt DateTime @default(now()) @map("dibuat_pada")

  @@map("notifikasi")
}

model BinResetRequest {
  id               String   @id @default(uuid())
  binId            String   @map("id_tong")
  bin              Bin      @relation(fields: [binId], references: [id])
  userId           String   @map("id_pengguna")
  user             User     @relation("RequestedResets", fields: [userId], references: [id])
  evidencePhotoUrl String   @map("url_foto_bukti")
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById     String?  @map("id_pereview")
  reviewedBy       User?    @relation("ReviewedResets", fields: [reviewedById], references: [id])
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  updatedAt        DateTime @updatedAt @map("diperbarui_pada")

  @@map("pengajuan_aktivasi_tong")
}

model Schedule {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  time      String?
  category  String
  location  String?
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  @@map("jadwal")
}

enum OwnershipType {
  UTAMA
  TAMBAHAN
}

model BinOwnership {
  id        String        @id @default(uuid())
  binId     String        @map("id_tong")
  userId    String        @map("id_pengguna")
  type      OwnershipType @map("tipe_kepemilikan")
  createdAt DateTime      @default(now()) @map("dibuat_pada")

  bin       Bin           @relation(fields: [binId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([binId, userId])
  @@map("kepemilikan_tong")
}

enum DispatchStatus {
  PENDING
  CLAIMED
  COMPLETED
  ESCALATED
}

model DispatchTask {
  id              String         @id @default(uuid())
  binId           String         @map("id_tong")
  bin             Bin            @relation(fields: [binId], references: [id], onDelete: Cascade)
  status          DispatchStatus @default(PENDING)
  claimedByUserId String?        @map("id_pengguna_mengklaim")
  claimedByUser   User?          @relation("ClaimedTasks", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("dibuat_pada")
  updatedAt       DateTime       @updatedAt @map("diperbarui_pada")

  @@map("tugas_penjemputan")
}

model Peternakan {
  id             String                   @id @default(uuid())
  nama           String
  pemilik        String
  noWa           String                   @map("no_wa")
  populasi       Int                      @default(0)
  hasilPanenKg   Decimal                  @default(0.0) @map("hasil_panen_kg") @db.Decimal(10, 2)
  createdAt      DateTime                 @default(now()) @map("dibuat_pada")
  updatedAt      DateTime                 @updatedAt @map("diperbarui_pada")
  distributions  MaggotDistributionLog[]

  @@map("peternakan")
}

model MaggotDistributionLog {
  id            String      @id @default(uuid())
  peternakanId  String      @map("id_peternakan")
  peternakan    Peternakan  @relation(fields: [peternakanId], references: [id], onDelete: Cascade)
  quantityKg    Decimal     @map("kuantitas_kg") @db.Decimal(10, 2)
  tanggal       DateTime    @default(now()) @map("tanggal")
  createdAt     DateTime    @default(now()) @map("dibuat_pada")

  @@map("catatan_distribusi_maggot")
}

model Violation {
  id               String   @id @default(uuid())
  userId           String   @map("id_pengguna")
  user             User     @relation("WargaViolations", fields: [userId], references: [id], onDelete: Cascade)
  binId            String?  @map("id_tong")
  bin              Bin?     @relation(fields: [binId], references: [id], onDelete: SetNull)
  petugasUserId    String   @map("id_pengguna_petugas")
  petugasUser      User     @relation("RecordedViolations", fields: [petugasUserId], references: [id], onDelete: Cascade)
  type             String   // e.g. "RESIDU_MIXED_ORGANIC", "RESIDU_MIXED_ANORGANIK"
  severity         String   // e.g. "LIGHT", "MEDIUM", "SEVERE"
  evidencePhotoUrl String   @map("url_foto_bukti")
  notes            String?
  pointsDeducted   Int      @map("poin_dikurangi")
  createdAt        DateTime @default(now()) @map("dibuat_pada")

  @@map("pelanggaran")
}

model KknHandoverHistory {
  id            String   @id @default(uuid())
  fromUserId    String   @map("id_pengguna_dari")
  fromUser      User     @relation("FromStudentHandovers", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String   @map("id_pengguna_ke")
  toUser        User     @relation("ToStudentHandovers", fields: [toUserId], references: [id], onDelete: Cascade)
  rtRwId        Int      @map("id_rt_rw")
  rtRw          RtRwArea @relation(fields: [rtRwId], references: [id], onDelete: Cascade)
  notes         String?
  handoverDate  DateTime @default(now()) @map("tanggal_serah_terima")

  @@map("riwayat_serah_terima_kkn")
}

