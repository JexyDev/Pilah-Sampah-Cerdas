# ==========================================
# Root / Docker Compose Environment Variables
# ==========================================

# Database PostgreSQL
DATABASE_URL=postgresql://psc_user:psc_password@localhost:5432/psc_db
POSTGRES_USER=psc_user
POSTGRES_PASSWORD=psc_password
POSTGRES_DB=psc_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=ganti_ini_dengan_string_random_minimal_32_karakter
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:3000

# Firebase
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# WhatsApp OTP (Fonnte)
FONNTE_TOKEN=isi_token_fonnte_di_sini
