{
  "name": "pilahsampah-id",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "description": "Monorepo for BERSEKA (Bersih, Sehat, Kampung Asri) — Intelligent Waste Management System",
  "author": "Jeremy Darrell & Muhammad Habil Putrawan",
  "license": "UNLICENSED",
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:all": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "test:api": "npm exec --workspace=apps/api -- vitest run",
    "bulk-insert-kkn": "npm run bulk-insert-kkn --workspace=apps/api --"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
