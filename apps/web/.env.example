# ==========================================
# Frontend Web (Vite + React) Environment Variables
# ==========================================

# Base URL untuk REST API Backend
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Base URL untuk WebSocket (Opsional, jika tidak diisi akan otomatis diturunkan dari VITE_API_BASE_URL)
# VITE_WS_URL=ws://localhost:3000

# URL Tile Layer untuk Peta OpenStreetMap / Leaflet
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Nama Aplikasi
VITE_APP_NAME=Pilah Sampah Cerdas

# Environment Frontend (development / staging / production)
VITE_APP_ENV=development
