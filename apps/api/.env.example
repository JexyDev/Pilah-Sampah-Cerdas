# Environment Variables — TEMPLATE
# Salin file ini ke .env dan isi nilainya sebelum menjalankan server

# ==============================
# DATABASE
# ==============================
DATABASE_URL=postgresql://postgres:password@localhost:5432/pilahsampah_db

# ==============================
# REDIS
# ==============================
REDIS_URL=redis://localhost:6379

# ==============================
# JWT AUTH
# ==============================
JWT_SECRET=ganti_ini_dengan_string_random_minimal_32_karakter
JWT_EXPIRES_IN=24h

# ==============================
# SERVER
# ==============================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================
# NGROK (untuk Mobile/Flutter)
# ==============================
# Isi dengan URL Ngrok yang aktif (berubah setiap session)
NGROK_URL=https://xxxx.ngrok-free.app

# ==============================
# FONNTE (WhatsApp OTP API)
# ==============================
# Daftar di https://fonnte.com — isi dengan API token device WhatsApp Anda
FONNTE_TOKEN=isi_token_fonnte_di_sini
