# ==========================================
# Backend API (Express + Prisma) Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya
# ==========================================

# ==============================
# 1. DATABASE (PostgreSQL)
# ==============================
DATABASE_URL=postgresql://psc_user:psc_password@localhost:5432/psc_db

# ==============================
# 2. REDIS & QUEUE (BullMQ / Caching)
# ==============================
REDIS_URL=redis://localhost:6379
# Atau konfigurasi terpisah jika diperlukan oleh worker/queue:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ==============================
# 3. AUTHENTICATION & SECURITY
# ==============================
# Kunci rahasia JWT (Ganti dengan string acak panjang, min. 32 karakter)
JWT_SECRET=ganti_ini_dengan_string_random_minimal_32_karakter
JWT_ACCESS_SECRET=ganti_ini_dengan_string_random_minimal_32_karakter
JWT_EXPIRES_IN=24h

# Kunci enkripsi data sensitif (AES-256-CBC, 32-byte hex string)
# ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================
# 4. SERVER & CORS
# ==============================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==============================
# 5. WHATSAPP GATEWAY (Fonnte OTP)
# ==============================
# Daftar di https://fonnte.com — isi dengan API token device WhatsApp Anda
FONNTE_TOKEN=isi_token_fonnte_di_sini

# ==============================
# 6. FIREBASE CLOUD MESSAGING (Push Notification)
# ==============================
# Path ke service account JSON atau string JSON langsung
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ==============================
# 7. AI MODEL SERVING (TrashCare-v1, YOLOv8-seg)
# ==============================
# MOCK = pakai mock adapter (development tanpa server AI). VENDOR = endpoint FastAPI/ONNX riil.
AI_VENDOR_PROVIDER=VENDOR
AI_VENDOR_ENDPOINT=http://localhost:8000/predict
AI_VENDOR_API_KEY=

# ==============================
# 8. DEVELOPMENT & TUNING FLAGS (Opsional)
# ==============================
# Bypass batasan koordinat wilayah Coblong (true / false)
DISABLE_GEO_BOUNDS=false
# Bypass batasan radius geofence tempat sampah pada mode development (true / false)
ALLOW_GEOFENCE_BYPASS=false
# Izinkan seed database pada NODE_ENV=production (true / false)
ALLOW_PROD_SEED=false

# URL Ngrok untuk testing webhook / Mobile Flutter
# NGROK_URL=https://xxxx.ngrok-free.app

# ==============================
# 9. APP VERSION & FORCE UPDATE
# ==============================
APP_MIN_REQUIRED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL=https://berseka.id/downloads/berseka-release-arm64-v8a.apk

