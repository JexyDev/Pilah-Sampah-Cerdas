// ─────────────────────────────────────────────
// LOGBOOK KKN (MAHASISWA & DPL)
// ─────────────────────────────────────────────

model LogbookKkn {
  id              String           @id @default(uuid())
  nomor           Int?             @map("nomor")
  kelompokId      String           @map("id_kelompok")
  penulisId       String           @map("id_penulis")
  tanggalKegiatan DateTime         @map("tanggal_kegiatan") @db.Date
  waktuMulai      String?          @map("waktu_mulai")
  waktuSelesai    String?          @map("waktu_selesai")
  tempat          String           @map("tempat")
  deskripsi       String           @map("deskripsi")
  fotoBuktiUrl    String?          @map("foto_bukti_url")
  attachmentUrls  Json?            @map("lampiran_urls")
  platformOs      String?          @default("ANDROID") @map("platform_os")
  tipeAktivitas   TipeAktivitasKkn @default(KELOMPOK) @map("tipe_aktivitas")
  programKerjaId  String?          @map("id_program_kerja")
  fasilitasId     String?          @map("id_fasilitas")

  // Status Approval 2-Tingkat
  statusApproval StatusLogbookKkn @default(MENUNGGU_PERSETUJUAN_KETUA) @map("status_persetujuan")

  // Approval Ketua Kelompok
  disetujuiKetuaOlehId String?   @map("id_ketua_penyetuju")
  disetujuiKetuaPada   DateTime? @map("disetujui_ketua_pada")
  catatanKetua         String?   @map("catatan_ketua")

  // Verifikasi DPL
  diverifikasiDplOlehId String?   @map("id_dpl_verifikator")
  diverifikasiDplPada   DateTime? @map("diverifikasi_dpl_pada")
  catatanDpl            String?   @map("catatan_dpl")

  pekanKe   Int      @default(1) @map("pekan_ke")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  kelompok            KelompokKkn      @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  penulis             User             @relation("LogbookPenulis", fields: [penulisId], references: [id], onDelete: Cascade)
  disetujuiKetuaOleh  User?            @relation("LogbookKetuaPenyetuju", fields: [disetujuiKetuaOlehId], references: [id])
  diverifikasiDplOleh User?            @relation("LogbookDplVerifikator", fields: [diverifikasiDplOlehId], references: [id])
  programKerja        ProgramKerjaKkn? @relation(fields: [programKerjaId], references: [id], onDelete: SetNull)
  fasilitas           Facility?        @relation(fields: [fasilitasId], references: [id], onDelete: SetNull)

  @@index([kelompokId, tanggalKegiatan(sort: Desc)])
  @@index([penulisId])
  @@index([statusApproval])
  @@map("logbook_kkn")
}

model LogbookDpl {
  id             String   @id @default(uuid())
  dplId          String   @map("id_dpl")
  kelompokId     String   @map("id_kelompok")
  tanggal        DateTime @map("tanggal") @db.Date
  waktuMulai     String?  @map("waktu_mulai")
  waktuSelesai   String?  @map("waktu_selesai")
  kategori       String?  @default("Kunjungan Lapangan") @map("kategori")
  tempat         String   @map("tempat")
  programKerjaId String?  @map("id_program_kerja")
  deskripsi      String   @map("deskripsi")
  arahanEvaluasi String?  @map("arahan_evaluasi")
  fotoBuktiUrl   String?  @map("foto_bukti_url")
  status         String?  @default("TERKIRIM") @map("status")
  durasiMenit    Int?     @default(120) @map("durasi_menit")
  simpanLokasi   Boolean? @default(true) @map("simpan_lokasi")
  pekanKe        Int      @default(1) @map("pekan_ke")
  createdAt      DateTime @default(now()) @map("dibuat_pada")
  updatedAt      DateTime @updatedAt @map("diperbarui_pada")

  dpl      User        @relation("DplLogbooks", fields: [dplId], references: [id], onDelete: Cascade)
  kelompok KelompokKkn @relation(fields: [kelompokId], references: [id], onDelete: Cascade)

  @@index([dplId, pekanKe])
  @@index([kelompokId])
  @@map("logbook_dpl")
}

enum TipeAktivitasKkn {
  KELOMPOK
  INDIVIDU
}

enum StatusLogbookKkn {
  MENUNGGU_PERSETUJUAN_KETUA
  DITOLAK_KETUA
  MENUNGGU_VERIFIKASI_DPL
  DISETUJUI_DPL
  PERLU_REVISI_DPL
}

model UserNotificationSync {
  userId             String   @id @map("id_pengguna")
  readIds            String   @db.Text
  markAllTimestamp   BigInt   @default(0)
  deleteAllTimestamp BigInt   @default(0)
  updatedAt          DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sinkronisasi_notifikasi_user")
}

// ─────────────────────────────────────────────
// BERITA & KONTEN (CMS — Kegiatan Mahasiswa Real-time)
// ─────────────────────────────────────────────

model BeritaKonten {
  id           String    @id @default(uuid())
  judul        String    @map("judul")
  slug         String    @unique @map("slug")
  konten       String    @map("konten") @db.Text
  ringkasan    String?   @map("ringkasan") @db.Text
  gambarUrl    String?   @map("gambar_url")
  kategori     String    @default("KKN") @map("kategori")   // UMUM | KKN | PENGUMUMAN
  status       String    @default("DRAFT") @map("status")   // DRAFT | PUBLISHED | ARCHIVED
  publishedAt  DateTime? @map("diterbitkan_pada")
  authorId     String?   @map("id_penulis")
  kelompokId   String?   @map("id_kelompok")
  viewCount    Int       @default(0) @map("jumlah_tayangan")
  tags         String?   @map("tags")
  createdAt    DateTime  @default(now()) @map("dibuat_pada")
  updatedAt    DateTime  @updatedAt @map("diperbarui_pada")
  author       User?     @relation("BeritaAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([kategori])
  @@index([kelompokId])
  @@map("berita_konten")
}
