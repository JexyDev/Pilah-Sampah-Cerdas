generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ROLE & PERMISSION (RBAC Dinamis)
// ─────────────────────────────────────────────

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @map("nama")
  createdAt   DateTime     @default(now()) @map("dibuat_pada")
  updatedAt   DateTime     @updatedAt @map("diperbarui_pada")
  users       User[]
  permissions Permission[]

  @@map("peran")
}

/**
 * Hak akses per role per resource — dikelola via UI SUPER USER
 */
model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("id_peran")
  resource  String   @map("resource")
  canView   Boolean  @default(false) @map("bisa_lihat")
  canCreate Boolean  @default(false) @map("bisa_buat")
  canEdit   Boolean  @default(false) @map("bisa_edit")
  canDelete Boolean  @default(false) @map("bisa_hapus")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("hak_akses")
}

// ─────────────────────────────────────────────
// HIERARKI WILAYAH
// ─────────────────────────────────────────────

model Provinsi {
  id         Int         @id @default(autoincrement())
  name       String      @unique @map("nama")
  createdAt  DateTime    @default(now()) @map("dibuat_pada")
  updatedAt  DateTime    @updatedAt @map("diperbarui_pada")
  kabupatens Kabupaten[]

  @@map("provinsi")
}

model Kabupaten {
  id         Int         @id @default(autoincrement())
  provinsiId Int         @map("id_provinsi")
  name       String      @map("nama")
  createdAt  DateTime    @default(now()) @map("dibuat_pada")
  updatedAt  DateTime    @updatedAt @map("diperbarui_pada")
  provinsi   Provinsi    @relation(fields: [provinsiId], references: [id], onDelete: Cascade)
  kecamatans Kecamatan[]

  @@unique([provinsiId, name])
  @@map("kabupaten")
}

model Kecamatan {
  id          Int         @id @default(autoincrement())
  kabupatenId Int         @map("id_kabupaten")
  name        String      @map("nama")
  createdAt   DateTime    @default(now()) @map("dibuat_pada")
  updatedAt   DateTime    @updatedAt @map("diperbarui_pada")
  kabupaten   Kabupaten   @relation(fields: [kabupatenId], references: [id], onDelete: Cascade)
  kelurahans  Kelurahan[]

  @@unique([kabupatenId, name])
  @@map("kecamatan")
}

model Kelurahan {
  id          String     @id @default(uuid())
  kecamatanId Int?       @map("id_kecamatan")
  name        String     @unique @map("nama")
  createdAt   DateTime   @default(now()) @map("dibuat_pada")
  updatedAt   DateTime   @updatedAt @map("diperbarui_pada")
  kecamatan   Kecamatan? @relation(fields: [kecamatanId], references: [id])
  bins        Bin[]
  rws         Rw[]

  @@map("kelurahan")
}

/**
 * RW — pengganti RtRwArea, relasi ke Kelurahan
 */
model Rw {
  id              Int                      @id @default(autoincrement())
  kelurahanId     String                   @map("id_kelurahan")
  name            String                   @map("nama")
  latitude        Decimal?                 @db.Decimal(11, 8)
  longitude       Decimal?                 @db.Decimal(11, 8)
  petugasResiduId String?                  @unique @map("id_petugas_residu")
  createdAt       DateTime                 @default(now()) @map("dibuat_pada")
  updatedAt       DateTime                 @updatedAt @map("diperbarui_pada")
  kelurahan       Kelurahan                @relation(fields: [kelurahanId], references: [id])
  petugasResidu   User?                    @relation("RwPetugasResidu", fields: [petugasResiduId], references: [id])
  rts             Rt[]
  users           User[]
  bins            Bin[]
  facilities      Facility[]
  studentsKkn     StudentKkn[]
  pemanfaatan     Pemanfaatan[]
  kritikSaran     KritikSaranPemanfaatan[]
  households      Household[]
  setoranManual   SetoranManual[]
  handovers       KknHandoverHistory[]

  @@unique([kelurahanId, name])
  @@map("rw")
}

/**
 * RT — tabel baru, relasi ke Rw
 */
model Rt {
  id        Int      @id @default(autoincrement())
  rwId      Int      @map("id_rw")
  name      String   @map("nama")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  rw        Rw       @relation(fields: [rwId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([rwId, name])
  @@map("rt")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                    String                   @id @default(uuid())
  name                  String                   @map("nama")
  password              String                   @map("kata_sandi")
  fcmToken              String?                  @map("token_fcm")
  roleId                Int                      @map("id_peran")
  createdAt             DateTime                 @default(now()) @map("dibuat_pada")
  updatedAt             DateTime                 @updatedAt @map("diperbarui_pada")
  fotoProfil            String?                  @map("foto_profil")
  rwId                  Int?                     @map("id_rw")
  rtId                  Int?                     @map("id_rt")
  status                String                   @default("Aktif")
  address               String?                  @map("alamat")
  phone                 String                   @unique @map("no_telepon")
  mustChangePassword    Boolean                  @default(false) @map("harus_ganti_password")
  wargaSubtype          String?                  @map("subtipe_warga")
  nip                   String?                  @map("nip")
  institusi             String?                  @map("institusi")
  jabatan               String?                  @map("jabatan")
  programStudi          String?                  @map("program_studi")
  jenjangPendidikan     String?                  @map("jenjang_pendidikan")
  provinsi              String?                  @map("provinsi")
  kabupaten             String?                  @map("kabupaten")
  jumlahAnggotaKeluarga Int?                     @map("jumlah_anggota_keluarga")
  defaultPetugasId      String?                  @map("id_petugas_tetap")
  bankSampahLedger      BankSampahLedger?
  aiRequestLogs         AiRequestLog[]
  picBatches            QrBatch[]                @relation("PicBatches")
  ideDaurUlang          IdeDaurUlang[]
  auditLogs             AuditTrail[]
  attendances           ActivityAttendance[]     @relation("StudentAttendance")
  dplKelompok           KelompokKkn[]            @relation("DplKelompok")
  binOwnerships         BinOwnership[]
  locations             StudentLocation[]        @relation("StudentLocations")
  studentProfile        StudentKkn?
  notifications         Notification[]
  wargaViolations       Violation[]              @relation("WargaViolations")
  recordedViolations    Violation[]              @relation("RecordedViolations")
  requestedResets       BinResetRequest[]        @relation("RequestedResets")
  reviewedResets        BinResetRequest[]        @relation("ReviewedResets")
  assignedResets        BinResetRequest[]        @relation("ResetRequestPetugas")
  role                  Role                     @relation(fields: [roleId], references: [id])
  rw                    Rw?                      @relation(fields: [rwId], references: [id])
  rt                    Rt?                      @relation(fields: [rtId], references: [id])
  petugasProfile        PetugasResidu?
  pointHistory          PointHistory[]
  fromHandovers         KknHandoverHistory[]     @relation("FromStudentHandovers")
  toHandovers           KknHandoverHistory[]     @relation("ToStudentHandovers")
  households            Household[]
  setoranManual         SetoranManual[]          @relation("PetugasSetoranManual")
  setoranOtomatis       SetoranOtomatis[]
  refreshTokens         RefreshToken[]
  registeredBins        Bin[]                    @relation("StudentRegisteredBins")
  bins                  Bin[]                    @relation("UserBins")
  claimedTasks          DispatchTask[]           @relation("ClaimedTasks")
  rwOwned               Rw?                      @relation("RwPetugasResidu")
  studentLeaveRequests  StudentLeaveRequest[]    @relation("StudentLeaveRequests")
  reviewedLeaveRequests StudentLeaveRequest[]    @relation("ReviewedLeaveRequests")
  importLogs            ImportLog[]              @relation("UserImportLogs")
  validasiBaseline      SurveiKelurahan[]        @relation("DplBaselineValidasi")
  validasiEndline       EndlineSurveiKelurahan[] @relation("DplEndlineValidasi")
  kritikSaran           KritikSaranPemanfaatan[] @relation("UserKritikSaran")
  reviewedProkers       ProgramKerjaKkn[]        @relation("DplReviewedProker")
  penilaianKkn          PenilaianKknMahasiswa?   @relation("StudentPenilaianKkn")
  penilaianKknDiberikan PenilaianKknMahasiswa[]  @relation("DplPenilaianKkn")
  penilaianKknMpl       PenilaianKknMahasiswa[]  @relation("MplPenilaianKkn")
  mplKelompok           KelompokKkn[]            @relation("MplKelompok")
  mplStudents           StudentKkn[]             @relation("MplStudent")
  facilitiesRegistered  Facility[]               @relation("FacilityRegisteredBy")
  logbooksWritten       LogbookKkn[]             @relation("LogbookPenulis")
  logbooksApprovedKetua LogbookKkn[]             @relation("LogbookKetuaPenyetuju")
  logbooksVerifiedDpl   LogbookKkn[]             @relation("LogbookDplVerifikator")
  dplLogbooks           LogbookDpl[]             @relation("DplLogbooks")
  notificationSync      UserNotificationSync?
  beritaKonten          BeritaKonten[]           @relation("BeritaAuthor")
  presensiMandiri       PresensiMandiri[]        @relation("PresensiMandiriStudent")

  @@index([roleId])
  @@index([rwId])
  @@index([rtId])
  @@map("pengguna")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  token     String   @unique
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("token_penyegar")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  used      Boolean  @default(false)

  @@index([phone, used, expiresAt])
  @@map("kode_otp")
}

// ─────────────────────────────────────────────
// RUMAH TANGGA
// ─────────────────────────────────────────────

model Household {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  address   String
  rwId      Int?     @map("id_rw")
  latitude  Decimal  @db.Decimal(11, 8)
  longitude Decimal  @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  user      User     @relation(fields: [userId], references: [id])
  rw        Rw?      @relation(fields: [rwId], references: [id])

  @@map("rumah_tangga")
}

// ─────────────────────────────────────────────
// SAMPAH & TEMPAT SAMPAH
// ─────────────────────────────────────────────

model WasteCategory {
  id          String   @id @default(uuid())
  name        String   @unique @map("nama")
  pointsPerKg Int      @map("poin_per_kg")
  description String?
  createdAt   DateTime @default(now()) @map("dibuat_pada")
  updatedAt   DateTime @updatedAt @map("diperbarui_pada")
  bins        Bin[]

  @@map("kategori_sampah")
}

model QrBatch {
  id                String   @id @default(uuid())
  batchCode         String   @unique @map("kode_gelombang")
  status            String
  assignedPicUserId String?  @map("id_pengguna_pic_ditugaskan")
  totalQr           Int      @map("total_qr")
  printedAt         DateTime @default(now()) @map("dicetak_pada")
  createdAt         DateTime @default(now()) @map("dibuat_pada")
  updatedAt         DateTime @updatedAt @map("diperbarui_pada")
  assignedPic       User?    @relation("PicBatches", fields: [assignedPicUserId], references: [id])
  bins              Bin[]

  @@map("gelombang_qr")
}

model Bin {
  id                    String            @id @default(uuid())
  qrCode                String            @unique @map("kode_qr")
  categoryId            String?           @map("id_kategori")
  maxCapacityLiter      Decimal           @default(25.0) @map("maks_kapasitas_liter") @db.Decimal(5, 2)
  currentVolumeLiter    Decimal           @default(0.0) @map("volume_sekarang_liter") @db.Decimal(5, 2)
  rwId                  Int?              @map("id_rw")
  kelurahanId           String?           @map("id_kelurahan")
  createdAt             DateTime          @default(now()) @map("dibuat_pada")
  updatedAt             DateTime          @updatedAt @map("diperbarui_pada")
  latitude              Decimal?          @db.Decimal(11, 8)
  longitude             Decimal?          @db.Decimal(11, 8)
  qrBatchId             String?           @map("id_gelombang_qr")
  status                BinStatus         @default(PRINTED)
  userId                String?           @map("id_pengguna")
  shape                 String?           @map("bentuk")
  diameter              Decimal?          @map("diameter") @db.Decimal(5, 2)
  registeredByStudentId String?           @map("id_mahasiswa_pendaftar")
  width                 Decimal?          @map("lebar") @db.Decimal(5, 2)
  length                Decimal?          @map("panjang") @db.Decimal(5, 2)
  height                Decimal?          @map("tinggi") @db.Decimal(5, 2)
  binType               String?           @map("tipe_wadah")
  binOwnerships         BinOwnership[]
  violations            Violation[]
  binResetRequests      BinResetRequest[]
  setoranOtomatis       SetoranOtomatis[]
  dispatchTasks         DispatchTask[]
  qrBatch               QrBatch?          @relation(fields: [qrBatchId], references: [id])
  category              WasteCategory?    @relation(fields: [categoryId], references: [id])
  kelurahan             Kelurahan?        @relation(fields: [kelurahanId], references: [id])
  registeredByStudent   User?             @relation("StudentRegisteredBins", fields: [registeredByStudentId], references: [id])
  user                  User?             @relation("UserBins", fields: [userId], references: [id])
  rw                    Rw?               @relation(fields: [rwId], references: [id])

  @@map("tempat_sampah")
}

// ─────────────────────────────────────────────
// KKN
// ─────────────────────────────────────────────

model StudentKkn {
  id                String       @id @default(uuid())
  userId            String       @unique @map("id_pengguna")
  nim               String?      @unique
  jurusan           String
  fakultas          String
  noWa              String       @map("no_wa")
  startDate         DateTime     @map("tanggal_mulai")
  endDate           DateTime     @map("tanggal_selesai")
  assignedRwId      Int?         @map("id_rw_ditugaskan")
  whitelistStatus   String       @default("PENDING") @map("status_whitelist")
  createdAt         DateTime     @default(now()) @map("dibuat_pada")
  updatedAt         DateTime     @updatedAt @map("diperbarui_pada")
  kelompokId        String?      @map("id_kelompok")
  mplId             String?      @map("id_mpl")
  assessmentScore   Decimal?     @default(0.0) @map("skor_penilaian_dpl") @db.Decimal(5, 2)
  assessmentNote    String?      @map("catatan_penilaian_dpl")
  isAssessed        Boolean      @default(false) @map("sudah_dinilai")
  isKetua           Boolean      @default(false) @map("is_ketua")
  jenjangPendidikan String?      @map("jenjang_pendidikan")
  kelompok          KelompokKkn? @relation(fields: [kelompokId], references: [id])
  mpl               User?        @relation("MplStudent", fields: [mplId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRw        Rw?          @relation(fields: [assignedRwId], references: [id])
  programKerja      ProgramKerjaKkn[]

  @@index([kelompokId])
  @@index([mplId])
  @@index([assignedRwId])
  @@map("mahasiswa_kkn")
}

model KelompokKkn {
  id                    String                  @id @default(uuid())
  name                  String                  @unique @map("nama")
  kelurahan             String?                 @map("kelurahan")
  cakupanRw             Json?                   @map("cakupan_rw")
  dplNamaMentah         String?                 @map("dpl_nama_mentah")
  dplId                 String?                 @map("id_dpl")
  mplId                 String?                 @map("id_mpl")
  // === SMART ZONE: Auto-generated polygon dari GPS mahasiswa aktif ===
  autoPolygon           Json?                   @map("auto_polygon")
  autoPolygonUpdatedAt  DateTime?               @map("auto_polygon_updated_at")
  autoPolygonStudentCount Int?                  @map("auto_polygon_student_count")
  createdAt             DateTime                @default(now()) @map("dibuat_pada")
  updatedAt             DateTime                @updatedAt @map("diperbarui_pada")
  dpl                   User?                   @relation("DplKelompok", fields: [dplId], references: [id])
  mpl                   User?                   @relation("MplKelompok", fields: [mplId], references: [id])
  students              StudentKkn[]
  schedules             Schedule[]
  timelines             TimelineKkn[]
  programKerja          ProgramKerjaKkn[]
  penilaianMahasiswa    PenilaianKknMahasiswa[]
  facilities            Facility[]
  poskoKkn              PoskoKkn?
  poskoMulti            PoskoKknMulti[]
  logbooks              LogbookKkn[]
  dplLogbooks           LogbookDpl[]
  presensiMandiri       PresensiMandiri[]

  @@index([dplId])
  @@map("kelompok_kkn")
}

model PoskoKkn {
  id         String      @id @default(uuid())
  kelompokId String      @unique @map("id_kelompok")
  nama       String
  alamat     String
  latitude   Decimal     @db.Decimal(11, 8)
  longitude  Decimal     @db.Decimal(11, 8)
  fotoUrl    String?     @map("foto_url")
  keterangan String?
  createdAt  DateTime    @default(now()) @map("dibuat_pada")
  updatedAt  DateTime    @updatedAt @map("diperbarui_pada")
  kelompok   KelompokKkn @relation(fields: [kelompokId], references: [id], onDelete: Cascade)

  @@map("posko_kkn")
}

// === SMART ZONE: Multi-Posko per Kelompok ===
// Mendukung kelompok KKN yang berpencar di beberapa titik sekaligus
model PoskoKknMulti {
  id         String      @id @default(uuid())
  kelompokId String      @map("id_kelompok")
  nama       String
  alamat     String
  latitude   Decimal     @db.Decimal(11, 8)
  longitude  Decimal     @db.Decimal(11, 8)
  isUtama    Boolean     @default(false) @map("is_utama")
  radius     Int         @default(150)
  fotoUrl    String?     @map("foto_url")
  keterangan String?
  createdAt  DateTime    @default(now()) @map("dibuat_pada")
  updatedAt  DateTime    @updatedAt @map("diperbarui_pada")
  kelompok   KelompokKkn @relation(fields: [kelompokId], references: [id], onDelete: Cascade)

  @@index([kelompokId])
  @@map("posko_kkn_multi")
}

model ProgramKerjaKkn {
  id                String       @id @default(uuid())
  kelompokId        String       @map("id_kelompok")
  studentId         String?      @map("id_mahasiswa")
  nomor             Int?         @map("nomor")
  deskripsi         String       @map("deskripsi")
  kategori          String?      @default("LAINNYA") @map("kategori")
  sumber            String?      @default("MAHASISWA") @map("sumber")
  waktuPelaksanaan  String?      @map("waktu_pelaksanaan")
  linkGoogleDrive   String?      @map("link_google_drive")
  attachmentFile    String?      @map("lampiran_file")
  attachmentUrls    Json?        @map("lampiran_urls")
  hasAttachment     Boolean      @default(false) @map("ada_lampiran")
  kebutuhanBiaya    Decimal      @default(0.00) @map("kebutuhan_biaya") @db.Decimal(12, 2)
  status            StatusProker @default(BELUM_DISETUJUI) @map("status")
  statusUsulan      String?      @default("BELUM_DISETUJUI") @map("status_usulan")
  statusPelaksanaan String?      @default("BELUM_MULAI") @map("status_pelaksanaan")
  catatanDpl        String?      @map("catatan_dpl")
  reviewedById      String?      @map("id_pereview")
  reviewedAt        DateTime?    @map("direview_pada")
  skorPenilaian     Decimal?     @map("skor_penilaian") @db.Decimal(5, 2)
  evaluasiDpl       String?      @map("evaluasi_dpl")
  aspekPenilaian    Json?        @map("aspek_penilaian")
  predikat          String?      @map("predikat")
  statusPenilaian   String?      @default("BELUM_DINILAI") @map("status_penilaian")
  createdAt         DateTime     @default(now()) @map("dibuat_pada")
  updatedAt         DateTime     @updatedAt @map("diperbarui_pada")
  kelompok          KelompokKkn  @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  student           StudentKkn?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reviewedBy        User?        @relation("DplReviewedProker", fields: [reviewedById], references: [id])
  logbooks          LogbookKkn[]
  pemanfaatan       Pemanfaatan[]
  kritikSaran       KritikSaranPemanfaatan[]

  @@index([studentId])
  @@map("program_kerja_kkn")
}

model PenilaianKknMahasiswa {
  id               String  @id @default(uuid())
  studentId        String  @unique @map("id_mahasiswa")
  kelompokId       String? @map("id_kelompok")
  dplId            String? @map("id_dpl")
  mitraId          String? @map("id_mitra")
  mplId            String? @map("id_mpl")
  namaMitraPenilai String? @map("nama_mitra_penilai")

  // Skor Aspek Mitra / PL (0 - 4)
  skorMitraKehadiran     Int     @default(0) @map("skor_mitra_kehadiran")
  skorMitraWargaBinaan   Int     @default(0) @map("skor_mitra_warga_binaan")
  skorMitraProker        Int     @default(0) @map("skor_mitra_proker")
  skorMitraKomunikasi    Int     @default(0) @map("skor_mitra_komunikasi")
  skorMitraTanggungJawab Int     @default(0) @map("skor_mitra_tanggung_jawab")
  skorMitraBuktiKegiatan Int     @default(0) @map("skor_mitra_bukti_kegiatan")
  skorMitraDampak        Int     @default(0) @map("skor_mitra_dampak")
  skorMitraInisiatif     Int     @default(0) @map("skor_mitra_inisiatif")
  subtotalMitra          Decimal @default(0.00) @map("subtotal_mitra") @db.Decimal(5, 2)

  // Skor Aspek DPL (0 - 4)
  skorDplPerencanaan  Int     @default(0) @map("skor_dpl_perencanaan")
  skorDplKontribusi   Int     @default(0) @map("skor_dpl_kontribusi")
  skorDplLogbook      Int     @default(0) @map("skor_dpl_logbook")
  skorDplAnalisis     Int     @default(0) @map("skor_dpl_analisis")
  skorDplOutput       Int     @default(0) @map("skor_dpl_output")
  skorDplLaporanAkhir Int     @default(0) @map("skor_dpl_laporan_akhir")
  subtotalDpl         Decimal @default(0.00) @map("subtotal_dpl") @db.Decimal(5, 2)

  // Nilai Akhir & Kategori
  nilaiAkhir    Decimal @default(0.00) @map("nilai_akhir") @db.Decimal(5, 2)
  kategoriNilai String? @map("kategori_nilai")

  // Catatan & Status
  catatanDpl   String?            @map("catatan_dpl")
  catatanMitra String?            @map("catatan_mitra")
  status       StatusPenilaianKkn @default(DRAFT) @map("status")
  isFinalized  Boolean            @default(false) @map("is_finalized")
  finalizedAt  DateTime?          @map("difinalisasi_pada")

  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  student  User         @relation("StudentPenilaianKkn", fields: [studentId], references: [id], onDelete: Cascade)
  dpl      User?        @relation("DplPenilaianKkn", fields: [dplId], references: [id])
  mpl      User?        @relation("MplPenilaianKkn", fields: [mplId], references: [id])
  kelompok KelompokKkn? @relation(fields: [kelompokId], references: [id], onDelete: Cascade)

