generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ROLE & PERMISSION (RBAC Dinamis)
// ─────────────────────────────────────────────

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @map("nama")
  createdAt   DateTime     @default(now()) @map("dibuat_pada")
  updatedAt   DateTime     @updatedAt @map("diperbarui_pada")
  users       User[]
  permissions Permission[]

  @@map("peran")
}

/** Hak akses per role per resource — dikelola via UI SUPER USER */
model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("id_peran")
  resource  String   @map("resource")
  canView   Boolean  @default(false) @map("bisa_lihat")
  canCreate Boolean  @default(false) @map("bisa_buat")
  canEdit   Boolean  @default(false) @map("bisa_edit")
  canDelete Boolean  @default(false) @map("bisa_hapus")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("hak_akses")
}

// ─────────────────────────────────────────────
// HIERARKI WILAYAH
// ─────────────────────────────────────────────

model Provinsi {
  id         Int         @id @default(autoincrement())
  name       String      @unique @map("nama")
  createdAt  DateTime    @default(now()) @map("dibuat_pada")
  updatedAt  DateTime    @updatedAt @map("diperbarui_pada")
  kabupatens Kabupaten[]

  @@map("provinsi")
}

model Kabupaten {
  id         Int        @id @default(autoincrement())
  provinsiId Int        @map("id_provinsi")
  name       String     @map("nama")
  createdAt  DateTime   @default(now()) @map("dibuat_pada")
  updatedAt  DateTime   @updatedAt @map("diperbarui_pada")
  provinsi   Provinsi   @relation(fields: [provinsiId], references: [id], onDelete: Cascade)
  kecamatans Kecamatan[]

  @@unique([provinsiId, name])
  @@map("kabupaten")
}

model Kecamatan {
  id          Int         @id @default(autoincrement())
  kabupatenId Int         @map("id_kabupaten")
  name        String      @map("nama")
  createdAt   DateTime    @default(now()) @map("dibuat_pada")
  updatedAt   DateTime    @updatedAt @map("diperbarui_pada")
  kabupaten   Kabupaten   @relation(fields: [kabupatenId], references: [id], onDelete: Cascade)
  kelurahans  Kelurahan[]

  @@unique([kabupatenId, name])
  @@map("kecamatan")
}

model Kelurahan {
  id          String    @id @default(uuid())
  kecamatanId Int?      @map("id_kecamatan")
  name        String    @unique @map("nama")
  createdAt   DateTime  @default(now()) @map("dibuat_pada")
  updatedAt   DateTime  @updatedAt @map("diperbarui_pada")
  kecamatan   Kecamatan? @relation(fields: [kecamatanId], references: [id])
  bins        Bin[]
  rws         Rw[]

  @@map("kelurahan")
}

/** RW — pengganti RtRwArea, relasi ke Kelurahan */
model Rw {
  id              Int                  @id @default(autoincrement())
  kelurahanId     String               @map("id_kelurahan")
  name            String               @map("nama")
  latitude        Decimal?             @db.Decimal(11, 8)
  longitude       Decimal?             @db.Decimal(11, 8)
  petugasResiduId String?              @unique @map("id_petugas_residu")
  createdAt       DateTime             @default(now()) @map("dibuat_pada")
  updatedAt       DateTime             @updatedAt @map("diperbarui_pada")
  kelurahan       Kelurahan            @relation(fields: [kelurahanId], references: [id])
  petugasResidu   User?                @relation("RwPetugasResidu", fields: [petugasResiduId], references: [id])
  rts             Rt[]
  users           User[]
  bins            Bin[]
  facilities      Facility[]
  studentsKkn     StudentKkn[]
  pemanfaatan     Pemanfaatan[]
  kritikSaran     KritikSaranPemanfaatan[]
  households      Household[]
  setoranManual   SetoranManual[]
  handovers       KknHandoverHistory[]

  @@unique([kelurahanId, name])
  @@map("rw")
}

/** RT — tabel baru, relasi ke Rw */
model Rt {
  id        Int      @id @default(autoincrement())
  rwId      Int      @map("id_rw")
  name      String   @map("nama")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  rw        Rw       @relation(fields: [rwId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([rwId, name])
  @@map("rt")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                    String               @id @default(uuid())
  name                  String               @map("nama")
  password              String               @map("kata_sandi")
  fcmToken              String?              @map("token_fcm")
  roleId                Int                  @map("id_peran")
  createdAt             DateTime             @default(now()) @map("dibuat_pada")
  updatedAt             DateTime             @updatedAt @map("diperbarui_pada")
  fotoProfil            String?              @map("foto_profil")
  rwId                  Int?                 @map("id_rw")
  rtId                  Int?                 @map("id_rt")
  status                String               @default("Aktif")
  address               String?              @map("alamat")
  phone                 String               @unique @map("no_telepon")
  mustChangePassword    Boolean              @default(false) @map("harus_ganti_password")
  wargaSubtype          String?              @map("subtipe_warga")
  nip                   String?              @map("nip")
  institusi             String?              @map("institusi")
  jabatan               String?              @map("jabatan")
  programStudi          String?              @map("program_studi")
  jenjangPendidikan     String?              @map("jenjang_pendidikan")
  provinsi              String?              @map("provinsi")
  kabupaten             String?              @map("kabupaten")
  jumlahAnggotaKeluarga Int?                 @map("jumlah_anggota_keluarga")
  defaultPetugasId      String?              @map("id_petugas_tetap")
  bankSampahLedger      BankSampahLedger?
  aiRequestLogs         AiRequestLog[]
  picBatches            QrBatch[]            @relation("PicBatches")
  ideDaurUlang          IdeDaurUlang[]
  auditLogs             AuditTrail[]
  attendances           ActivityAttendance[] @relation("StudentAttendance")
  dplKelompok           KelompokKkn[]        @relation("DplKelompok")
  binOwnerships         BinOwnership[]
  locations             StudentLocation[]    @relation("StudentLocations")
  studentProfile        StudentKkn?
  notifications         Notification[]
  wargaViolations       Violation[]          @relation("WargaViolations")
  recordedViolations    Violation[]          @relation("RecordedViolations")
  requestedResets       BinResetRequest[]    @relation("RequestedResets")
  reviewedResets        BinResetRequest[]    @relation("ReviewedResets")
  assignedResets        BinResetRequest[]    @relation("ResetRequestPetugas")
  role                  Role                 @relation(fields: [roleId], references: [id])
  rw                    Rw?                  @relation(fields: [rwId], references: [id])
  rt                    Rt?                  @relation(fields: [rtId], references: [id])
  petugasProfile        PetugasResidu?
  pointHistory          PointHistory[]
  fromHandovers         KknHandoverHistory[] @relation("FromStudentHandovers")
  toHandovers           KknHandoverHistory[] @relation("ToStudentHandovers")
  households            Household[]
  setoranManual         SetoranManual[]      @relation("PetugasSetoranManual")
  setoranOtomatis       SetoranOtomatis[]
  refreshTokens         RefreshToken[]
  registeredBins        Bin[]                @relation("StudentRegisteredBins")
  bins                  Bin[]                @relation("UserBins")
  claimedTasks          DispatchTask[]       @relation("ClaimedTasks")
  rwOwned               Rw?                  @relation("RwPetugasResidu")
  studentLeaveRequests  StudentLeaveRequest[] @relation("StudentLeaveRequests")
  reviewedLeaveRequests StudentLeaveRequest[] @relation("ReviewedLeaveRequests")
  importLogs            ImportLog[]          @relation("UserImportLogs")
  validasiBaseline      SurveiKelurahan[]    @relation("DplBaselineValidasi")
  validasiEndline       EndlineSurveiKelurahan[] @relation("DplEndlineValidasi")
  kritikSaran           KritikSaranPemanfaatan[] @relation("UserKritikSaran")

  @@map("pengguna")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  token     String   @unique
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  user      User     @relation(fields: [userId], references: [id])

  @@map("token_penyegar")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("kedaluwarsa_pada")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  used      Boolean  @default(false)

  @@map("kode_otp")
}

// ─────────────────────────────────────────────
// RUMAH TANGGA
// ─────────────────────────────────────────────

model Household {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  address   String
  rwId      Int      @map("id_rw")
  latitude  Decimal  @db.Decimal(11, 8)
  longitude Decimal  @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")
  user      User     @relation(fields: [userId], references: [id])
  rw        Rw       @relation(fields: [rwId], references: [id])

  @@map("rumah_tangga")
}

// ─────────────────────────────────────────────
// SAMPAH & TEMPAT SAMPAH
// ─────────────────────────────────────────────

model WasteCategory {
  id          String   @id @default(uuid())
  name        String   @unique @map("nama")
  pointsPerKg Int      @map("poin_per_kg")
  description String?
  createdAt   DateTime @default(now()) @map("dibuat_pada")
  updatedAt   DateTime @updatedAt @map("diperbarui_pada")
  bins        Bin[]

  @@map("kategori_sampah")
}

model QrBatch {
  id                String   @id @default(uuid())
  batchCode         String   @unique @map("kode_gelombang")
  status            String
  assignedPicUserId String?  @map("id_pengguna_pic_ditugaskan")
  totalQr           Int      @map("total_qr")
  printedAt         DateTime @default(now()) @map("dicetak_pada")
  createdAt         DateTime @default(now()) @map("dibuat_pada")
  updatedAt         DateTime @updatedAt @map("diperbarui_pada")
  assignedPic       User?    @relation("PicBatches", fields: [assignedPicUserId], references: [id])
  bins              Bin[]

  @@map("gelombang_qr")
}

model Bin {
  id                    String            @id @default(uuid())
  qrCode                String            @unique @map("kode_qr")
  categoryId            String?           @map("id_kategori")
  maxCapacityLiter      Decimal           @default(25.0) @map("maks_kapasitas_liter") @db.Decimal(5, 2)
  currentVolumeLiter    Decimal           @default(0.0) @map("volume_sekarang_liter") @db.Decimal(5, 2)
  rwId                  Int?              @map("id_rw")
  kelurahanId           String?           @map("id_kelurahan")
  createdAt             DateTime          @default(now()) @map("dibuat_pada")
  updatedAt             DateTime          @updatedAt @map("diperbarui_pada")
  latitude              Decimal?          @db.Decimal(11, 8)
  longitude             Decimal?          @db.Decimal(11, 8)
  qrBatchId             String?           @map("id_gelombang_qr")
  status                BinStatus         @default(PRINTED)
  userId                String?           @map("id_pengguna")
  shape                 String?           @map("bentuk")
  diameter              Decimal?          @map("diameter") @db.Decimal(5, 2)
  registeredByStudentId String?           @map("id_mahasiswa_pendaftar")
  width                 Decimal?          @map("lebar") @db.Decimal(5, 2)
  length                Decimal?          @map("panjang") @db.Decimal(5, 2)
  height                Decimal?          @map("tinggi") @db.Decimal(5, 2)
  binType               String?           @map("tipe_wadah")
  binOwnerships         BinOwnership[]
  violations            Violation[]
  binResetRequests      BinResetRequest[]
  setoranOtomatis       SetoranOtomatis[]
  dispatchTasks         DispatchTask[]
  qrBatch               QrBatch?          @relation(fields: [qrBatchId], references: [id])
  category              WasteCategory?    @relation(fields: [categoryId], references: [id])
  kelurahan             Kelurahan?        @relation(fields: [kelurahanId], references: [id])
  registeredByStudent   User?             @relation("StudentRegisteredBins", fields: [registeredByStudentId], references: [id])
  user                  User?             @relation("UserBins", fields: [userId], references: [id])
  rw                    Rw?               @relation(fields: [rwId], references: [id])

  @@map("tempat_sampah")
}

// ─────────────────────────────────────────────
// KKN
// ─────────────────────────────────────────────

model StudentKkn {
  id                String       @id @default(uuid())
  userId            String       @unique @map("id_pengguna")
  nim               String?      @unique
  jurusan           String
  fakultas          String
  noWa              String       @map("no_wa")
  startDate         DateTime     @map("tanggal_mulai")
  endDate           DateTime     @map("tanggal_selesai")
  assignedRwId      Int?         @map("id_rw_ditugaskan")
  whitelistStatus   String       @default("PENDING") @map("status_whitelist")
  createdAt         DateTime     @default(now()) @map("dibuat_pada")
  updatedAt         DateTime     @updatedAt @map("diperbarui_pada")
  kelompokId        String?      @map("id_kelompok")
  assessmentScore   Decimal?     @default(0.0) @map("skor_penilaian_dpl") @db.Decimal(5, 2)
  isKetua           Boolean      @default(false) @map("is_ketua")
  jenjangPendidikan String?      @map("jenjang_pendidikan")
  kelompok          KelompokKkn? @relation(fields: [kelompokId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRw        Rw?          @relation(fields: [assignedRwId], references: [id])

  @@map("mahasiswa_kkn")
}

model KelompokKkn {
  id            String       @id @default(uuid())
  name          String       @unique @map("nama")
  kelurahan     String?      @map("kelurahan")
  cakupanRw     Json?        @map("cakupan_rw")
  dplNamaMentah String?      @map("dpl_nama_mentah")
  dplId         String?      @map("id_dpl")
  createdAt     DateTime     @default(now()) @map("dibuat_pada")
  updatedAt     DateTime     @updatedAt @map("diperbarui_pada")
  dpl           User?        @relation("DplKelompok", fields: [dplId], references: [id])
  students      StudentKkn[]
  schedules     Schedule[]

  @@map("kelompok_kkn")
}

model KknHandoverHistory {
  id           String   @id @default(uuid())
  fromUserId   String   @map("id_pengguna_dari")
  toUserId     String   @map("id_pengguna_ke")
  rwId         Int      @map("id_rw")
  notes        String?
  handoverDate DateTime @default(now()) @map("tanggal_serah_terima")
  fromUser     User     @relation("FromStudentHandovers", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User     @relation("ToStudentHandovers", fields: [toUserId], references: [id], onDelete: Cascade)
  rw           Rw       @relation(fields: [rwId], references: [id], onDelete: Cascade)

  @@map("riwayat_serah_terima_kkn")
}

model ActivityAttendance {
  id         String    @id @default(uuid())
  studentId  String    @map("id_mahasiswa")
  scheduleId String    @map("id_jadwal")
  attendedAt DateTime  @default(now()) @map("waktu_absen")
  method     String    @map("metode")
  latitude   Decimal   @map("latitude") @db.Decimal(11, 8)
  longitude  Decimal   @map("longitude") @db.Decimal(11, 8)
  checkOutAt DateTime? @map("waktu_checkout")
  status     String    @default("DALAM_RADIUS") @map("status")
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId])
  @@map("kehadiran_kegiatan")
}

model StudentLocation {
  id         String   @id @default(uuid())
  studentId  String   @map("id_mahasiswa")
  latitude   Decimal  @db.Decimal(11, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  recordedAt DateTime @default(now()) @map("direkam_pada")
  student    User     @relation("StudentLocations", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([recordedAt])
  @@map("lokasi_mahasiswa")
}

model StudentLeaveRequest {
  id              String    @id @default(uuid())
  studentId       String    @map("id_mahasiswa")
  type            String    @map("tipe")
  reason          String    @map("alasan")
  evidenceUrl     String?   @map("url_bukti")
  startDate       DateTime  @map("tanggal_mulai")
  endDate         DateTime  @map("tanggal_selesai")
  status          String    @default("PENDING") @map("status")
  reviewedById    String?   @map("id_pereview")
  reviewedAt      DateTime? @map("direview_pada")
  rejectionReason String?   @map("alasan_penolakan")
  createdAt       DateTime  @default(now()) @map("dibuat_pada")
  updatedAt       DateTime  @updatedAt @map("diperbarui_pada")
  student         User      @relation("StudentLeaveRequests", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy      User?     @relation("ReviewedLeaveRequests", fields: [reviewedById], references: [id])

  @@map("pengajuan_izin_mahasiswa")
}

// ─────────────────────────────────────────────
// PETUGAS RESIDU
// ─────────────────────────────────────────────

model PetugasResidu {
  id              String   @id @default(uuid())
  userId          String   @unique @map("id_pengguna")
  nama            String
  noWa            String   @map("no_wa")
  kpiScore        Decimal  @default(100.0) @map("skor_kpi") @db.Decimal(5, 2)
  assignedZone    String?  @map("zona_ditugaskan")
  createdAt       DateTime @default(now()) @map("dibuat_pada")
  updatedAt       DateTime @updatedAt @map("diperbarui_pada")
  latitude        Decimal? @map("latitude") @db.Decimal(11, 8)
  longitude       Decimal? @map("longitude") @db.Decimal(11, 8)
  whitelistStatus String   @default("PENDING") @map("status_whitelist")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("petugas_residu")
}

// ─────────────────────────────────────────────
// FASILITAS & PRODUKSI
// ─────────────────────────────────────────────

model Facility {
  id             String                  @id @default(uuid())
  jenis          FacilityType
  nama           String
  pic            String
  foto           String?
  kontak         String?
  kapasitas      Decimal?                @db.Decimal(10, 2)
  latitude       Decimal                 @db.Decimal(11, 8)
  longitude      Decimal                 @db.Decimal(11, 8)
  createdAt      DateTime                @default(now()) @map("dibuat_pada")
  updatedAt      DateTime                @updatedAt @map("diperbarui_pada")
  rwId           Int?                    @map("id_rw")
  statusApproval String                  @default("PENDING") @map("status_persetujuan")
  productionLogs FacilityProductionLog[]
  rw             Rw?                     @relation(fields: [rwId], references: [id])

  @@map("fasilitas")
}

model FacilityProductionLog {
  id              String   @id @default(uuid())
  facilityId      String   @map("id_fasilitas")
  materialMasukKg Decimal  @map("material_masuk_kg") @db.Decimal(10, 2)
  outputKg        Decimal  @map("output_kg") @db.Decimal(10, 2)
  jenisOutput     String   @map("jenis_output")
  periode         String
  createdAt       DateTime @default(now()) @map("dibuat_pada")
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("catatan_produksi_fasilitas")
}

// ─────────────────────────────────────────────
// SETORAN SAMPAH
// ─────────────────────────────────────────────

model SetoranOtomatis {
  id                 String   @id @default(uuid())
  wargaId            String   @map("warga_id")
  fotoSampahUrl      String   @map("foto_sampah_url")
  hasilKlasifikasiAi String   @map("hasil_klasifikasi_ai")
  confidenceAi       Decimal  @map("confidence_ai") @db.Decimal(5, 2)
  berat              Decimal  @map("berat") @db.Decimal(10, 2)
  unit               String   @default("Kg") @map("unit")
  poin               Decimal  @map("poin") @db.Decimal(10, 2)
  qrTempatSampahId   String   @map("qr_tempat_sampah_id")
  lokasiGps          String?  @map("lokasi_gps")
  ratingWarga        Int?     @default(5) @map("rating_warga")
  kategoriAktual     String?  @map("kategori_aktual")
  statusDataset      String   @default("Siap Retrain") @map("status_dataset")
  status             String   @default("PENDING") @map("status")
  catatanPenolakan   String?  @map("catatan_penolakan")
  createdAt          DateTime @default(now()) @map("created_at")
  bin                Bin      @relation(fields: [qrTempatSampahId], references: [id], onDelete: Cascade)
  warga              User     @relation(fields: [wargaId], references: [id], onDelete: Cascade)

  @@map("setoran_otomatis")
}

model SetoranManual {
  id              String   @id @default(uuid())
  petugasResiduId String   @map("petugas_residu_id")
  diinputOleh     String   @map("diinput_oleh")
  rwId            Int      @map("rw_id")
  fotoResiduUrl   String   @map("foto_residu_url")
  berat           Decimal  @map("berat") @db.Decimal(10, 2)
  unit            String   @default("Kg") @map("unit")
  lokasiGps       String?  @map("lokasi_gps")
  kategori        String   @default("residu") @map("kategori")
  status          String   @default("PENDING") @map("status")
  catatanPenolakan String?  @map("catatan_penolakan")
  createdAt       DateTime @default(now()) @map("created_at")
  petugas         User     @relation("PetugasSetoranManual", fields: [petugasResiduId], references: [id], onDelete: Cascade)
  rw              Rw       @relation(fields: [rwId], references: [id], onDelete: Cascade)

  @@map("setoran_manual")
}

// ─────────────────────────────────────────────
// PEMANFAATAN SAMPAH
// ─────────────────────────────────────────────

model Pemanfaatan {
  id                      String   @id @default(uuid())
  rwId                    Int      @map("id_rw")
  nomorCaraPemanfaatan    String   @unique @map("nomor_cara_pemanfaatan")
  program                 String   @map("program")
  teknologi               String   @map("teknologi")
  bahanBaku               String   @map("bahan_baku")
  volumeBahanBaku         Decimal  @map("volume_bahan_baku") @db.Decimal(10, 2)
  unitBahanBaku           String   @map("unit_bahan_baku")
  hasil                   Decimal  @map("hasil") @db.Decimal(10, 2)
  unitHasil               String   @map("unit_hasil")
  fotoDokumentasiUrl      String   @map("foto_dokumentasi_url")
  tanggalPencatatan       DateTime @map("tanggal_pencatatan")
  jenisKomoditas          String?  @map("jenis_komoditas")
  luasLahanM2             Decimal? @map("luas_lahan_m2") @db.Decimal(8, 2)
  volumePupukDipakaiKg    Decimal? @map("volume_pupuk_dipakai_kg") @db.Decimal(10, 2)
  bibitTelurGram          Decimal? @map("bibit_telur_gram") @db.Decimal(8, 2)
  hasilKasgotKg           Decimal? @map("hasil_kasgot_kg") @db.Decimal(10, 2)
  volumeBioaktivatorLiter Decimal? @map("volume_bioaktivator_liter") @db.Decimal(8, 2)
  masaFermentasiHari      Int?     @map("masa_fermentasi_hari")
  createdAt               DateTime @default(now()) @map("dibuat_pada")
  rw                      Rw       @relation(fields: [rwId], references: [id], onDelete: Cascade)

  @@map("pemanfaatan_sampah")
}

model KritikSaranPemanfaatan {
  id               String    @id @default(uuid())
  userId           String    @map("id_pengguna")
  wargaNama        String    @map("warga_nama")
  kategori         String    @default("Pemanfaatan Sampah") @map("kategori")
  judul            String    @map("judul")
  isiKritikSaran   String    @map("isi_kritik_saran")
  rating           Int       @default(5) @map("rating")
  status           String    @default("MENUNGGU") @map("status")
  tanggapan        String?   @map("tanggapan")
  ditanggapiOleh   String?   @map("ditanggapi_oleh")
  ditanggapiPada   DateTime? @map("ditanggapi_pada")
  fotoBuktiUrl     String?   @map("foto_bukti_url")
  rwId             Int?      @map("id_rw")
  createdAt        DateTime  @default(now()) @map("dibuat_pada")
  updatedAt        DateTime  @updatedAt @map("diperbarui_pada")
  user             User      @relation("UserKritikSaran", fields: [userId], references: [id], onDelete: Cascade)
  rw               Rw?       @relation(fields: [rwId], references: [id])

  @@map("kritik_saran_pemanfaatan")
}

// ─────────────────────────────────────────────
// GAMIFIKASI & POIN
// ─────────────────────────────────────────────

model PointHistory {
  id          String   @id @default(uuid())
  userId      String   @map("id_pengguna")
  points      Int
  description String
  createdAt   DateTime @default(now()) @map("dibuat_pada")
  kategori    String   @default("REDUKSI_TONASE") @map("kategori")
  redeemable  Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id])

  @@map("riwayat_poin")
}

model BankSampahLedger {
  id               String   @id @default(uuid())
  userId           String   @unique @map("id_pengguna")
  saldoRupiah      Decimal  @default(0.0) @map("saldo_rupiah") @db.Decimal(12, 2)
  riwayatTransaksi Json     @default("[]") @map("riwayat_transaksi")
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  updatedAt        DateTime @updatedAt @map("diperbarui_pada")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buku_kas_bank_sampah")
}

model IdeDaurUlang {
  id             String   @id @default(uuid())
  userId         String   @map("id_pengguna")
  judul          String
  foto           String?
  material       String
  statusApproval String   @default("PENDING") @map("status_persetujuan")
  approvedBy     String?  @map("disetujui_oleh")
  createdAt      DateTime @default(now()) @map("dibuat_pada")
  updatedAt      DateTime @updatedAt @map("diperbarui_pada")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ide_daur_ulang")
}

model FlashDropEvent {
  id        String   @id @default(uuid())
  title     String
  latitude  Decimal  @db.Decimal(11, 8)
  longitude Decimal  @db.Decimal(11, 8)
  radius    Int      @default(100)
  points    Int      @default(50)
  startTime DateTime @map("waktu_mulai")
  endTime   DateTime @map("waktu_selesai")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  @@map("aksi_drop_sampah")
}

// ─────────────────────────────────────────────
// SISTEM & MONITORING
// ─────────────────────────────────────────────

model SystemConfig {
  key       String   @id
  value     String
  tipe      String
  deskripsi String?
  updatedBy String?  @map("diperbarui_oleh")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  @@map("konfigurasi_sistem")
}

model AuditTrail {
  id        String   @id @default(uuid())
  action    String
  userId    String?  @map("id_pengguna")
  timestamp DateTime @default(now())
  oldValue  Json?    @map("nilai_lama")
  newValue  Json?    @map("nilai_baru")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("jejak_audit")
}

model SocialFeed {
  id        String   @id @default(uuid())
  tipe      String
  deskripsi String
  userId    String?  @map("id_pengguna")
  entityId  String?  @map("id_entitas")
  timestamp DateTime @default(now())

  @@map("kabar_sosial")
}

model NotificationLog {
  id          String   @id @default(uuid())
  channel     String
  tujuan      String
  statusKirim String   @map("status_kirim")
  triggerType String   @map("tipe_pemicu")
  createdAt   DateTime @default(now()) @map("dibuat_pada")

  @@map("catatan_notifikasi")
}

model AiRequestLog {
  id           String   @id @default(uuid())
  userId       String   @map("id_pengguna")
  requestId    String   @unique @map("id_permintaan") @db.Uuid
  imageUrl     String   @map("url_gambar")
  resultStatus String   @map("status_hasil")
  createdAt    DateTime @default(now()) @map("dibuat_pada")
  user         User     @relation(fields: [userId], references: [id])

  @@map("catatan_permintaan_ai")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("id_pengguna")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("sudah_dibaca")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifikasi")
}

// ─────────────────────────────────────────────
// PENGANGKUTAN & DISPATCH
// ─────────────────────────────────────────────

model BinResetRequest {
  id               String   @id @default(uuid())
  binId            String   @map("id_tempat_sampah")
  userId           String   @map("id_pengguna")
  petugasId        String?  @map("id_petugas_tujuan")
  jenisSampah      String?  @map("jenis_sampah")
  evidencePhotoUrl String   @map("url_foto_bukti")
  status           String   @default("PENDING")
  reviewedById     String?  @map("id_pereview")
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  updatedAt        DateTime @updatedAt @map("diperbarui_pada")
  user             User     @relation("RequestedResets", fields: [userId], references: [id])
  reviewedBy       User?    @relation("ReviewedResets", fields: [reviewedById], references: [id])
  petugas          User?    @relation("ResetRequestPetugas", fields: [petugasId], references: [id])
  bin              Bin      @relation(fields: [binId], references: [id])

  @@map("pengajuan_aktivasi_tempat_sampah")
}

model Schedule {
  id          String               @id @default(uuid())
  title       String
  date        DateTime
  time        String?
  category    String
  location    String?
  createdAt   DateTime             @default(now()) @map("dibuat_pada")
  updatedAt   DateTime             @updatedAt @map("diperbarui_pada")
  latitude    Decimal?             @db.Decimal(11, 8)
  longitude   Decimal?             @db.Decimal(11, 8)
  polygon     Json?
  radius      Int?                 @default(100)
  kelompokId  String?              @map("id_kelompok")
  kelompok    KelompokKkn?         @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  attendances ActivityAttendance[]

  @@map("jadwal")
}

model BinOwnership {
  id        String        @id @default(uuid())
  binId     String        @map("id_tempat_sampah")
  userId    String        @map("id_pengguna")
  type      OwnershipType @map("tipe_kepemilikan")
  createdAt DateTime      @default(now()) @map("dibuat_pada")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bin       Bin           @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@unique([binId, userId])
  @@map("kepemilikan_tempat_sampah")
}

model DispatchTask {
  id              String         @id @default(uuid())
  binId           String         @map("id_tempat_sampah")
  status          DispatchStatus @default(PENDING)
  claimedByUserId String?        @map("id_pengguna_mengklaim")
  createdAt       DateTime       @default(now()) @map("dibuat_pada")
  updatedAt       DateTime       @updatedAt @map("diperbarui_pada")
  claimedByUser   User?          @relation("ClaimedTasks", fields: [claimedByUserId], references: [id])
  bin             Bin            @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@map("tugas_penjemputan")
}

// ─────────────────────────────────────────────
// PETERNAKAN & MAGGOT
// ─────────────────────────────────────────────

model Peternakan {
  id            String                  @id @default(uuid())
  nama          String
  pemilik       String
  noWa          String                  @map("no_wa")
  populasi      Int                     @default(0)
  hasilPanenKg  Decimal                 @default(0.00) @map("hasil_panen_kg") @db.Decimal(10, 2)
  createdAt     DateTime                @default(now()) @map("dibuat_pada")
  updatedAt     DateTime                @updatedAt @map("diperbarui_pada")
  distributions MaggotDistributionLog[]

  @@map("peternakan")
}

model MaggotDistributionLog {
  id           String     @id @default(uuid())
  peternakanId String     @map("id_peternakan")
  quantityKg   Decimal    @map("kuantitas_kg") @db.Decimal(10, 2)
  tanggal      DateTime   @default(now()) @map("tanggal")
  createdAt    DateTime   @default(now()) @map("dibuat_pada")
  peternakan   Peternakan @relation(fields: [peternakanId], references: [id], onDelete: Cascade)

  @@map("catatan_distribusi_maggot")
}

// ─────────────────────────────────────────────
// PELANGGARAN
// ─────────────────────────────────────────────

model Violation {
  id               String   @id @default(uuid())
  userId           String   @map("id_pengguna")
  binId            String?  @map("id_tempat_sampah")
  petugasUserId    String   @map("id_pengguna_petugas")
  type             String
  severity         String
  evidencePhotoUrl String   @map("url_foto_bukti")
  notes            String?
  pointsDeducted   Int      @map("poin_dikurangi")
  createdAt        DateTime @default(now()) @map("dibuat_pada")
  user             User     @relation("WargaViolations", fields: [userId], references: [id], onDelete: Cascade)
  petugasUser      User     @relation("RecordedViolations", fields: [petugasUserId], references: [id], onDelete: Cascade)
  bin              Bin?     @relation(fields: [binId], references: [id])

  @@map("pelanggaran")
}

// ─────────────────────────────────────────────
// SURVEI KKN (Data survei lapangan — terpisah dari master wilayah)
// ─────────────────────────────────────────────

model SurveiKelurahan {
  kelurahanId            Int       @id @map("id_kelurahan_survei")
  namaKelurahan          String    @map("nama_kelurahan") @db.VarChar(100)
  kecamatan              String?   @db.VarChar(100)
  jumlahRw               Int?      @map("jumlah_rw")
  jumlahRt               Int?      @map("jumlah_rt")
  tanggalSurvei          DateTime? @map("tanggal_survei") @db.Date
  jumlahKk               Int?      @map("jumlah_kk")
  jumlahRumahTotal       Int?      @map("jumlah_rumah_total")
  enumerator             String?   @db.VarChar(100)
  titikKumpulMahasiswa   String?   @map("titik_kumpul_mahasiswa") @db.VarChar(255)
  catatanData            String?   @map("catatan_data")
  validasiDplId          String?   @map("id_validasi_dpl")
  statusValidasi         String    @default("BELUM_VALIDASI") @map("status_validasi")
  catatanValidasi        String?   @map("catatan_validasi")
  createdAt              DateTime  @default(now()) @map("dibuat_pada")
  updatedAt              DateTime  @updatedAt @map("diperbarui_pada")

  karakteristikWilayah   SurveiKarakteristikWilayah?
  pemilahanSampah        SurveiPemilahanSampah?
  bankSampahPengolahan   SurveiBankSampahPengolahan?
  keyPlayers             SurveiKeyPlayer[]
  volumeSampah           SurveiVolumeSampah?
  catatanKesimpulan      SurveiCatatanKesimpulan?
  validasiDpl            User?     @relation("DplBaselineValidasi", fields: [validasiDplId], references: [id])

  @@map("survei_kelurahan")
}

model SurveiKarakteristikWilayah {
  id                              Int              @id @default(autoincrement())
  kelurahanId                     Int              @unique @map("id_kelurahan_survei")
  padatPenduduk                   Boolean?         @map("padat_penduduk")
  banyakKosKontrakan              Boolean?         @map("banyak_kos_kontrakan")
  banyakUmkmWarungKafe            Boolean?         @map("banyak_umkm_warung_kafe")
  dekatKampusSekolah              Boolean?         @map("dekat_kampus_sekolah")
  pasar                           Boolean?
  bantaranSungai                  Boolean?         @map("bantaran_sungai")
  karakterLainnyaFlag             Boolean?         @map("karakter_lainnya_flag")
  karakterLainnyaKeterangan       String?          @map("karakter_lainnya_keterangan")
  perkiraanJumlahKosKontrakan     String?          @map("perkiraan_jumlah_kos_kontrakan") @db.VarChar(50)
  perkiraanJumlahUmkmWarungKafe   String?          @map("perkiraan_jumlah_umkm_warung_kafe") @db.VarChar(50)
  kelurahan                       SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_karakteristik_wilayah")
}

model SurveiPemilahanSampah {
  id                       Int              @id @default(autoincrement())
  kelurahanId              Int              @unique @map("id_kelurahan_survei")
  jumlahRumahMemilah       Int?             @map("jumlah_rumah_memilah")
  totalJumlahRumahDiRw     Int?             @map("total_jumlah_rumah_di_rw")
  persentasePemilahan      Decimal?         @map("persentase_pemilahan") @db.Decimal(5, 4)
  tingkatPemilahan         String?          @map("tingkat_pemilahan") @db.VarChar(50)
  catatan                  String?
  kelurahan                SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_pemilahan_sampah")
}

model SurveiBankSampahPengolahan {
  id                             Int              @id @default(autoincrement())
  kelurahanId                    Int              @unique @map("id_kelurahan_survei")
  bankSampahAktif                Int?             @map("bank_sampah_aktif")
  bankSampahTidakAktif           Int?             @map("bank_sampah_tidak_aktif")
  jumlahUnitKomposter            String?          @map("jumlah_unit_komposter") @db.VarChar(50)
  jumlahTitikMaggotBsf           String?          @map("jumlah_titik_maggot_bsf") @db.VarChar(100)
  bioporiLoseda                  Boolean?         @map("biopori_loseda")
  ecobrickKerajinanDaurUlang     Boolean?         @map("ecobrick_kerajinan_daur_ulang")
  buruanSae                      Boolean?         @map("buruan_sae")
  pengepulMitraDaurUlang         Boolean?         @map("pengepul_mitra_daur_ulang")
  digitalisasiData               Boolean?         @map("digitalisasi_data")
  aktivitasLainnyaKeterangan     String?          @map("aktivitas_lainnya_keterangan")
  kelurahan                      SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_bank_sampah_pengolahan")
}

model SurveiKeyPlayer {
  id            Int              @id @default(autoincrement())
  kelurahanId   Int              @map("id_kelurahan_survei")
  jenisAktor    String?          @map("jenis_aktor") @db.VarChar(100)
  nama          String?          @db.VarChar(150)
  kontak        String?          @db.VarChar(50)
  peran         String?          @db.VarChar(255)
  kelurahan     SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_key_player")
}

model SurveiVolumeSampah {
  id                      Int              @id @default(autoincrement())
  kelurahanId             Int              @unique @map("id_kelurahan_survei")
  organikKgPerHari        Decimal?         @map("organik_kg_per_hari") @db.Decimal(10, 2)
  anorganikKgPerHari      Decimal?         @map("anorganik_kg_per_hari") @db.Decimal(10, 2)
  residuKgPerHari         Decimal?         @map("residu_kg_per_hari") @db.Decimal(10, 2)
  totalVolumeKgPerHari    Decimal?         @map("total_volume_kg_per_hari") @db.Decimal(10, 2)
  catatan                 String?
  kelurahan               SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_volume_sampah")
}

model SurveiCatatanKesimpulan {
  id                            Int              @id @default(autoincrement())
  kelurahanId                   Int              @unique @map("id_kelurahan_survei")
  prioritasIntervensi           String?          @map("prioritas_intervensi")
  catatanTambahanRisikoSosial   String?          @map("catatan_tambahan_risiko_sosial")
  kelurahan                     SurveiKelurahan  @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("survei_catatan_kesimpulan")
}

// ─────────────────────────────────────────────
// ENDLINE SURVEI KKN (mirror dari Baseline untuk Evaluasi Dampak)
// ─────────────────────────────────────────────

model EndlineSurveiKelurahan {
  kelurahanId            Int       @id @map("id_kelurahan_endline")
  namaKelurahan          String    @map("nama_kelurahan") @db.VarChar(100)
  kecamatan              String?   @db.VarChar(100)
  tanggalSurvei          DateTime? @map("tanggal_survei") @db.Date
  enumerator             String?   @db.VarChar(100)
  catatanData            String?   @map("catatan_data")
  validasiDplId          String?   @map("id_validasi_dpl")
  statusValidasi         String    @default("BELUM_VALIDASI") @map("status_validasi")
  catatanValidasi        String?   @map("catatan_validasi")
  createdAt              DateTime  @default(now()) @map("dibuat_pada")
  updatedAt              DateTime  @updatedAt @map("diperbarui_pada")

  pemilahanSampah        EndlinePemilahanSampah?
  volumeSampah           EndlineVolumeSampah?
  bankSampahPengolahan   EndlineBankSampahPengolahan?
  catatanKesimpulan      EndlineCatatanKesimpulan?
  validasiDpl            User?     @relation("DplEndlineValidasi", fields: [validasiDplId], references: [id])

  @@map("endline_survei_kelurahan")
}

model EndlinePemilahanSampah {
  id                       Int                       @id @default(autoincrement())
  kelurahanId              Int                       @unique @map("id_kelurahan_endline")
  jumlahRumahMemilah       Int?                      @map("jumlah_rumah_memilah")
  totalJumlahRumahDiRw     Int?                      @map("total_jumlah_rumah_di_rw")
  persentasePemilahan      Decimal?                  @map("persentase_pemilahan") @db.Decimal(5, 4)
  tingkatPemilahan         String?                   @map("tingkat_pemilahan") @db.VarChar(50)
  catatan                  String?
  kelurahan                EndlineSurveiKelurahan    @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("endline_pemilahan_sampah")
}

model EndlineVolumeSampah {
  id                      Int                       @id @default(autoincrement())
  kelurahanId             Int                       @unique @map("id_kelurahan_endline")
  organikKgPerHari        Decimal?                  @map("organik_kg_per_hari") @db.Decimal(10, 2)
  anorganikKgPerHari      Decimal?                  @map("anorganik_kg_per_hari") @db.Decimal(10, 2)
  residuKgPerHari         Decimal?                  @map("residu_kg_per_hari") @db.Decimal(10, 2)
  totalVolumeKgPerHari    Decimal?                  @map("total_volume_kg_per_hari") @db.Decimal(10, 2)
  catatan                 String?
  kelurahan               EndlineSurveiKelurahan    @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("endline_volume_sampah")
}

model EndlineBankSampahPengolahan {
  id                             Int                       @id @default(autoincrement())
  kelurahanId                    Int                       @unique @map("id_kelurahan_endline")
  bankSampahAktif                Int?                      @map("bank_sampah_aktif")
  bankSampahTidakAktif           Int?                      @map("bank_sampah_tidak_aktif")
  jumlahUnitKomposter            String?                   @map("jumlah_unit_komposter") @db.VarChar(50)
  jumlahTitikMaggotBsf           String?                   @map("jumlah_titik_maggot_bsf") @db.VarChar(100)
  bioporiLoseda                  Boolean?                  @map("biopori_loseda")
  ecobrickKerajinanDaurUlang     Boolean?                  @map("ecobrick_kerajinan_daur_ulang")
  buruanSae                      Boolean?                  @map("buruan_sae")
  pengepulMitraDaurUlang         Boolean?                  @map("pengepul_mitra_daur_ulang")
  digitalisasiData               Boolean?                  @map("digitalisasi_data")
  aktivitasLainnyaKeterangan     String?                   @map("aktivitas_lainnya_keterangan")
  kelurahan                      EndlineSurveiKelurahan    @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("endline_bank_sampah_pengolahan")
}

model EndlineCatatanKesimpulan {
  id                            Int                       @id @default(autoincrement())
  kelurahanId                   Int                       @unique @map("id_kelurahan_endline")
  prioritasIntervensi           String?                   @map("prioritas_intervensi")
  catatanTambahanRisikoSosial   String?                   @map("catatan_tambahan_risiko_sosial")
  kelurahan                     EndlineSurveiKelurahan    @relation(fields: [kelurahanId], references: [kelurahanId], onDelete: Cascade)

  @@map("endline_catatan_kesimpulan")
}

/** Riwayat impor file ke database — untuk audit dan pelacakan */
model ImportLog {
  id            String       @id @default(uuid())
  userId        String       @map("id_pengguna")
  filename      String       @map("nama_file")
  status        ImportStatus @default(PENDING)
  summary       Json?        @map("ringkasan")
  errorMessages Json?        @map("pesan_error")
  rowsImported  Int          @default(0) @map("baris_diimpor")
  createdAt     DateTime     @default(now()) @map("dibuat_pada")
  user          User         @relation("UserImportLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("catatan_impor")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum BinStatus {
  PRINTED
  ASSIGNED_TO_PIC
  ACTIVE_BOUND
  BROKEN
  INACTIVE
  PENDING_APPROVAL
}

enum FacilityType {
  loseda
  bata_terawang
  rumah_maggot
  bank_sampah
  tps
  buruan_sae
  poc
}

enum OwnershipType {
  UTAMA
  TAMBAHAN
}

enum DispatchStatus {
  PENDING
  CLAIMED
  COMPLETED
  ESCALATED
}

enum ImportStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIAL
}
